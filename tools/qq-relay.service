# Linux systemd 模板：B 机器上的 QQ 中继
# 1) 改 WorkingDirectory / ExecStart / User
# 2) cp tools/qq-relay.service /etc/systemd/system/qq-relay.service
# 3) systemctl daemon-reload && systemctl enable --now qq-relay
# 4) journalctl -u qq-relay -f

[Unit]
Description=QQ image/message relay (A bot -> B website)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/AI-Helper-In-Minecraft
ExecStart=/usr/bin/python3 /opt/AI-Helper-In-Minecraft/tools/qq_relay.py --config /opt/AI-Helper-In-Minecraft/tools/qq_relay.json
Restart=always
RestartSec=3
# 日志直接进 journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
