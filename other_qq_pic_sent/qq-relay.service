# Linux systemd 模板：B 机器上的 QQ 中继 + Python Web 后台
# 1) 改 WorkingDirectory / ExecStart / User
# 2) cp other_qq_pic_sent/qq-relay.service /etc/systemd/system/qq-relay.service
# 3) systemctl daemon-reload && systemctl enable --now qq-relay
# 4) journalctl -u qq-relay -f

[Unit]
Description=QQ image/message relay + web (A bot -> B website)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/AI-Helper-In-Minecraft
ExecStart=/usr/bin/python3 /opt/AI-Helper-In-Minecraft/other_qq_pic_sent/webapp.py --config /opt/AI-Helper-In-Minecraft/other_qq_pic_sent/relay.json
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
