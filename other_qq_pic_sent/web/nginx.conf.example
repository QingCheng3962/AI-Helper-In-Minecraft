# B 机器：安全示例站点的 Nginx 配置
# 替换：
#   pic.qingchengsep.top -> 你的域名
#   /var/www/other_qq_pic_sent/web/public -> 实际目录
#   php8.2-fpm.sock -> 你的 PHP-FPM 版本
#
# 特点：
#   · 只把 web/public 作为站点根目录，src/、relay.py 不在 webroot
#   · /pic_http/ 反代到中继（图片）
#   · 禁止访问点文件和备份文件
# ============================================================

server {
    listen 80;
    server_name pic.qingchengsep.top;

    root /var/www/other_qq_pic_sent/web/public;
    index index.php;

    # 安全响应头（PHP 里也会发，双保险）
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # 图片：由中继提供
    location /pic_http/ {
        proxy_pass http://127.0.0.1:18765;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # PHP
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # 静态文件
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 禁止访问隐藏文件、备份、源码目录
    location ~ /\.(?!well-known) { deny all; }
    location ~* \.(?:bak|old|orig|save|swp|sql|db|log)$ { deny all; }
}
